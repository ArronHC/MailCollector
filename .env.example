PORT=3000
HOST=127.0.0.1
DATABASE_PATH=./data/mail-collector.db
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=replace-with-64-hex-characters
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_KEY=replace-with-a-long-random-secret
# Enable cross-origin desktop/web clients only on a self-hosted server behind HTTPS.
ALLOW_REMOTE_CLIENTS=false
# Optional comma-separated browser origins, for example https://mail-client.example.com
ALLOWED_REMOTE_ORIGINS=
# Explicit proxy IP/CIDR or Express preset, for example loopback or 172.18.0.0/16.
TRUSTED_PROXY=
# Reject plaintext requests. Enable together with TRUSTED_PROXY on the public server.
REQUIRE_HTTPS=false
# Required for the one-time administrator registration flow.
REGISTRATION_INVITE_CODE=replace-with-a-private-invite-code
# Set to true only when the IMAP server intentionally uses a private network address.
ALLOW_PRIVATE_MAIL_HOSTS=false
SYNC_INTERVAL_MINUTES=5
INITIAL_SYNC_LIMIT=100
MAX_MESSAGE_BYTES=10485760
BACKFILL_PAGE_SIZE=100
RECONCILE_MESSAGE_LIMIT=500
ACTIVE_RECONCILE_MINUTES=30
NORMAL_RECONCILE_MINUTES=180
INACTIVE_RECONCILE_MINUTES=720
SYNC_LEASE_SECONDS=300
PROVIDER_MAX_ATTEMPTS=5
PROVIDER_MAX_CONCURRENCY=3
MAIL_WORKER_INTERVAL_SECONDS=2
IMAP_IDLE_ENABLED=true
IMAP_IDLE_SCAN_SECONDS=30
IMAP_IDLE_DEBOUNCE_MS=750
IMAP_IDLE_RECONNECT_MAX_SECONDS=300
