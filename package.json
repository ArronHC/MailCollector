{
  "name": "mail-collector",
  "version": "0.8.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:web": "vite --config frontend/vite.config.ts",
    "build": "npm run build:server && npm run build:web",
    "build:server": "tsc",
    "build:web": "vite build --config frontend/vite.config.ts",
    "typecheck": "npm run typecheck:server && npm run typecheck:web",
    "typecheck:server": "tsc --noEmit",
    "typecheck:web": "tsc -p frontend/tsconfig.json --noEmit",
    "prepare:desktop-runtime": "node scripts/prepare-desktop-runtime.mjs",
    "build:desktop": "npm run build && npm run prepare-desktop-runtime.mjs",
    "desktop": "tauri dev",
    "dist:win": "tauri build --bundles nsis",
    "start": "node dist/server.js",
    "test": "node scripts/run-tests.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^12.2.0",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "imapflow": "^1.0.190",
    "lucide-react": "^0.468.0",
    "mailparser": "^3.7.4",
    "nodemailer": "^9.0.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@tauri-apps/api": "^2.11.1",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.3",
    "@types/mailparser": "^3.7.4",
    "@types/node": "^24.2.1",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "autoprefixer": "^10.5.4",
    "@tauri-apps/cli": "^2.11.4",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "vite": "^8.2.1"
  }
}
