{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mail Collector",
  "version": "0.5.1",
  "identifier": "com.openspace.mailcollector",
  "build": {
    "beforeDevCommand": "npm run build:desktop",
    "beforeBuildCommand": "npm run build:desktop",
    "frontendDist": "../public"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "capabilities": ["default"],
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": ["resources/runtime/**/*"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
