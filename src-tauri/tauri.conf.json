{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mail Collector",
  "version": "0.10.1",
  "identifier": "com.openspace.mailcollector",
  "build": {
    "beforeDevCommand": "npm run build:web",
    "beforeBuildCommand": "npm run build:web",
    "frontendDist": "../public"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Mail Collector",
        "width": 1440,
        "height": 920,
        "minWidth": 980,
        "minHeight": 680,
        "decorations": false
      }
    ],
    "security": {
      "capabilities": ["default"],
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
